<Window x:Class="FootNote.App.SearchBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FootNote Search"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ShowActivated="True" SizeToContent="Height" Width="560">

    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#F2F2F7"/>
        <SolidColorBrush x:Key="DimBrush" Color="#9B9BA8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4F8EF7"/>

        <!-- Material-style magnifying glass, reused (smaller) per result row. -->
        <Geometry x:Key="SearchIconGeometry">M15.5,14h-.79l-.28-.27C15.41,12.59,16,11.11,16,9.5A6.5,6.5,0,1,0,9.5,16,6.47,6.47,0,0,0,13.73,14.5l.27.28V15.5l5,5L20.5,19ZM9.5,14A4.5,4.5,0,1,1,14,9.5,4.5,4.5,0,0,1,9.5,14Z</Geometry>

        <Style x:Key="ResultItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <EventSetter Event="MouseLeftButtonUp" Handler="ResultItem_Click"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="10" Padding="10,9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#20FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2A4F8EF7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="0,4,0,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.Opacity>0</Grid.Opacity>

        <!-- Pill-shaped query field. Width is animated from a circle (Width ==
             Height) up to full size on open — matching the reference clip, which
             morphs a round icon button into the search bar rather than sliding
             or fading the whole shape in. ClipToBounds hides the icon/textbox
             until the pill is wide enough to show them, same as the reference. -->
        <Border x:Name="InputPill" Grid.Row="0" Height="54" Width="54" CornerRadius="27"
                HorizontalAlignment="Center" ClipToBounds="True"
                Background="#F51E1E2B" BorderBrush="#33FFFFFF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.28" BlurRadius="22" ShadowDepth="6" Direction="270"/>
            </Border.Effect>
            <Grid Width="560" VerticalAlignment="Center">
                <DockPanel LastChildFill="True" Margin="20,0" VerticalAlignment="Center">
                    <Viewbox DockPanel.Dock="Left" Width="17" Height="17" Margin="0,0,14,0"
                             VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Viewbox centers the icon's ink bounding box, but the
                             handle sticking out bottom-right pulls that bbox
                             center down-right of the lens itself — nudge the
                             rendered path up-left so the lens (the visual focal
                             point) is what actually sits centered. -->
                        <Path Data="{StaticResource SearchIconGeometry}" Fill="{StaticResource DimBrush}">
                            <Path.RenderTransform>
                                <TranslateTransform X="-1.7" Y="-1.5"/>
                            </Path.RenderTransform>
                        </Path>
                    </Viewbox>
                    <Grid VerticalAlignment="Center">
                        <StackPanel x:Name="HintRow" Orientation="Horizontal" IsHitTestVisible="False"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="HintText" FontSize="15" Foreground="{StaticResource DimBrush}"
                                       VerticalAlignment="Center" Text=""/>
                            <TextBlock x:Name="BlinkCaret" FontSize="15" Foreground="{StaticResource DimBrush}"
                                       VerticalAlignment="Center" Text="|" Margin="1,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <TextBox x:Name="QueryBox" FontSize="15" Background="Transparent"
                                 Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                                 BorderThickness="0" VerticalAlignment="Center" Padding="0"
                                 KeyDown="QueryBox_KeyDown"/>
                    </Grid>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Results dropdown, a separate rounded card below the pill (with a gap),
             matching the two-card reference layout. Only shown once there's something to show. -->
        <Border x:Name="ResultsCard" Grid.Row="1" Margin="0,10,0,0" CornerRadius="18"
                Background="#F51E1E2B" BorderBrush="#33FFFFFF" BorderThickness="1"
                Padding="8" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.28" BlurRadius="22" ShadowDepth="6" Direction="270"/>
            </Border.Effect>
            <Grid>
                <ScrollViewer x:Name="ResultsScroll" MaxHeight="360"
                              VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <ListBox x:Name="ResultsList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource ResultItem}"
                             KeyDown="ResultsList_KeyDown"
                             MouseDoubleClick="ResultsList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <Viewbox DockPanel.Dock="Left" Width="14" Height="14"
                                             Margin="0,2,10,0" VerticalAlignment="Top">
                                        <Path Data="{StaticResource SearchIconGeometry}" Fill="{StaticResource DimBrush}"/>
                                    </Viewbox>
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding WhenText}"
                                                       FontSize="10.5" Foreground="{StaticResource DimBrush}"
                                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            <TextBlock DockPanel.Dock="Left" FontSize="13.5"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding FileNamePrefix, Mode=OneWay}"
                                                     Foreground="{StaticResource TextBrush}"/>
                                                <Run Text="{Binding FileNameMatch, Mode=OneWay}"
                                                     FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                                <Run Text="{Binding FileNameSuffix, Mode=OneWay}"
                                                     Foreground="{StaticResource TextBrush}"/>
                                            </TextBlock>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Snippet}" FontSize="12" Margin="0,2,0,0"
                                                   Foreground="{StaticResource DimBrush}"
                                                   TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <TextBlock x:Name="EmptyText" Margin="10,10,10,8" FontSize="12.5"
                           Foreground="{StaticResource DimBrush}" Visibility="Collapsed"
                           Text="No notes matched."/>
            </Grid>
        </Border>
    </Grid>
</Window>
