<Window x:Class="FootNote.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FootNote Settings" Width="680" Height="560" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="#1E1E2B"
        ShowInTaskbar="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Text" Color="#F2F2F7"/>
        <SolidColorBrush x:Key="Dim" Color="#9B9BA8"/>
        <SolidColorBrush x:Key="Card" Color="#28283A"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,16,0,6"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="0,4,16,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Settings sections -->
        <ScrollViewer Grid.Column="0" Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
            <StackPanel>

                <StackPanel x:Name="ProUpsellSection" Visibility="Collapsed">
                    <TextBlock Text="APPEARANCE &amp; POSITION" Style="{StaticResource SectionHeader}" Margin="2,0,0,6"/>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Panel position, accent color, panel style, and ink bloom color are Pro features." TextWrapping="Wrap"/>
                            <TextBlock Text="Unlock Full Version to customize how FootNote looks and where it docks."
                                       Foreground="{StaticResource Dim}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>

                            <!-- Store-Paid channel: native purchase UI, no key to type. -->
                            <StackPanel x:Name="StoreUnlockPanel" Visibility="Collapsed" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="BuyButton" Content="Unlock Full Version" Padding="10,5" Click="BuyButton_Click"/>
                                <TextBlock x:Name="StoreUnlockStatus" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Foreground="{StaticResource Dim}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PositionSection">
                <TextBlock Text="POSITION" Style="{StaticResource SectionHeader}" Margin="2,0,0,6"/>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Screen edge" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Bottom" IsChecked="{Binding EdgeBottom}"/>
                            <RadioButton Content="Top" IsChecked="{Binding EdgeTop}"/>
                        </StackPanel>
                        <TextBlock Text="Monitor" Margin="0,10,0,4"/>
                        <ComboBox ItemsSource="{Binding MonitorOptions}"
                                  SelectedIndex="{Binding MonitorSelectedIndex}"/>
                    </StackPanel>
                </Border>
                </StackPanel>

                <StackPanel x:Name="AppearanceSection">
                <TextBlock Text="APPEARANCE" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Accent color" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" x:Name="SwatchPanel">
                            <!-- swatches added in code-behind -->
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBox x:Name="HexBox" Width="110"
                                     Text="{Binding AccentColor, UpdateSourceTrigger=LostFocus}"
                                     Background="#3D3D4D" Foreground="{StaticResource Text}"
                                     BorderBrush="#5A5A6E" Padding="6,3" CaretBrush="{StaticResource Text}"/>
                            <Border Width="24" Height="24" CornerRadius="4" Margin="8,0,0,0"
                                    Background="{Binding AccentBrush}"/>
                            <TextBlock Text="{Binding AccentError}" Foreground="#F26B6B"
                                       Margin="10,4,0,0" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                </StackPanel>

                <StackPanel x:Name="PanelSection">
                <TextBlock Text="PANEL" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Bar style" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Full-width bar" IsChecked="{Binding StyleBar}"/>
                            <RadioButton Content="Floating pill" IsChecked="{Binding StylePill}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Background" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Width="92" Text="{Binding PanelColor, UpdateSourceTrigger=LostFocus}"
                                     Background="#3D3D4D" Foreground="{StaticResource Text}"
                                     BorderBrush="#5A5A6E" Padding="6,3" CaretBrush="{StaticResource Text}"/>
                            <Border Width="22" Height="22" CornerRadius="4" Margin="8,0,0,0"
                                    Background="{Binding PanelBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Corner radius" VerticalAlignment="Center"/>
                            <Slider Width="150" Minimum="0" Maximum="24" Margin="10,0"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding CornerRadius}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CornerRadiusLabel}" VerticalAlignment="Center"
                                       Foreground="{StaticResource Dim}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Size" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Width="120" SelectedIndex="{Binding SizeSelectedIndex}">
                                <ComboBoxItem Content="Comfortable"/>
                                <ComboBoxItem Content="Compact"/>
                            </ComboBox>
                            <TextBlock Text="Font" VerticalAlignment="Center" Margin="14,0,8,0"/>
                            <ComboBox Width="100" SelectedIndex="{Binding FontScaleSelectedIndex}">
                                <ComboBoxItem Content="Small"/>
                                <ComboBoxItem Content="Medium"/>
                                <ComboBoxItem Content="Large"/>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox Content="Real translucency (acrylic blur — costs a little performance)"
                                  IsChecked="{Binding Translucency}" Margin="0,8,0,0"/>
                        <CheckBox Content="Ink bloom (a soft colored glow behind every note)"
                                  IsChecked="{Binding BloomEnabled}" Margin="0,8,0,0"/>
                        <StackPanel Margin="18,6,0,0" IsEnabled="{Binding BloomEnabled}">
                            <StackPanel Orientation="Horizontal" x:Name="BloomSwatchPanel">
                                <!-- swatches added in code-behind -->
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBox Width="92" Text="{Binding BloomColor, UpdateSourceTrigger=LostFocus}"
                                         Background="#3D3D4D" Foreground="{StaticResource Text}"
                                         BorderBrush="#5A5A6E" Padding="6,3" CaretBrush="{StaticResource Text}"/>
                                <Border Width="22" Height="22" CornerRadius="4" Margin="8,0,0,0"
                                        Background="{Binding BloomBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                </StackPanel>

                <TextBlock Text="BEHAVIOR" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Auto-hide after" VerticalAlignment="Center"/>
                            <Slider Width="180" Minimum="2" Maximum="15" Margin="10,0"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding AutoHideSeconds}"
                                    IsEnabled="{Binding AutoHideEnabled}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AutoHideLabel}" VerticalAlignment="Center"
                                       Foreground="{StaticResource Dim}"/>
                        </StackPanel>
                        <CheckBox Content="Stay until dismissed (never auto-hide)"
                                  IsChecked="{Binding StayUntilDismissed}"/>
                        <CheckBox Content="Slide animation"
                                  IsChecked="{Binding SlideAnimation}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="HOTKEY" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Add / edit comment shortcut" Margin="0,0,0,6"/>
                        <TextBox x:Name="HotkeyBox" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 Text="{Binding HotkeyDisplay, Mode=OneWay}"
                                 Background="#3D3D4D" Foreground="{StaticResource Text}"
                                 BorderBrush="#5A5A6E" Padding="8,6" FontSize="14"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                 GotKeyboardFocus="HotkeyBox_GotFocus"/>
                        <TextBlock Text="Click the box, then press the new combination."
                                   Foreground="{StaticResource Dim}" FontSize="11" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding HotkeyStatus}" FontSize="11" Margin="0,4,0,0"
                                   Foreground="#8FD18F"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Live preview -->
        <StackPanel Grid.Column="1" Grid.Row="0">
            <TextBlock Text="PREVIEW" Style="{StaticResource SectionHeader}" Margin="2,0,0,6"/>
            <Border Background="#101018" CornerRadius="8" Height="170" Padding="8">
                <Grid x:Name="PreviewScreen">
                    <!-- mock desktop -->
                    <Border x:Name="PreviewBar" Background="{Binding PanelBrush}" BorderBrush="#33FFFFFF"
                            BorderThickness="1" CornerRadius="8,8,0,0" VerticalAlignment="Bottom"
                            Padding="10,7" Margin="14,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Ellipse Width="9" Height="9" Margin="0,0,5,0" VerticalAlignment="Center"
                                         Fill="{StaticResource BrandMarkBrush}"/>
                                <TextBlock Text="report.xlsx" FontWeight="SemiBold" FontSize="10"/>
                            </StackPanel>
                            <TextBlock Text="Draft — waiting on sign-off" FontSize="10"
                                       Foreground="{StaticResource Dim}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                                <Border Background="{Binding AccentBrush}" CornerRadius="4" Padding="8,2">
                                    <TextBlock Text="Save" FontSize="9"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <TextBlock Text="Changes apply instantly — there is no Save button."
                       Foreground="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap"
                       Margin="2,10,0,0"/>
        </StackPanel>

        <!-- Footer -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Reset to Defaults" Padding="12,6"
                    Command="{Binding ResetToDefaultsCommand}"
                    Background="#3D3D4D" Foreground="{StaticResource Text}" BorderThickness="0"/>
            <Button DockPanel.Dock="Right" Content="Close" Padding="16,6" Click="Close_Click"
                    Background="#3D3D4D" Foreground="{StaticResource Text}" BorderThickness="0"/>
        </DockPanel>
    </Grid>
</Window>
