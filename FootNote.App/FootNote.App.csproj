<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.3.0</Version>
    <ApplicationIcon>footnote.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>FootNote</AssemblyTitle>
    <Product>FootNote</Product>
    <!-- FootNoteTier: Free (default, GitHub/Store-Free builds) or Pro
         (Owner build today; Store-Paid once Store purchase is wired in).
         Pass -p:FootNoteTier=Pro to build.ps1 to build a Pro binary. -->
    <FootNoteTier Condition="'$(FootNoteTier)' == ''">Free</FootNoteTier>
    <DefineConstants Condition="'$(FootNoteTier)' == 'Pro'">$(DefineConstants);FOOTNOTE_PRO</DefineConstants>
    <!-- Mirrors FootNote.Pro.csproj's FootNoteChannel — needed here too so
         FootNote.App itself can gate anything Store policy forbids (e.g.
         the GitHub update checker: Store policy 10.2.5 requires updates
         come only through the Store, so a Store-channel build must not
         check GitHub or link out to a non-Store download at all). -->
    <FootNoteChannel Condition="'$(FootNoteChannel)' == ''">Owner</FootNoteChannel>
    <DefineConstants Condition="'$(FootNoteChannel)' == 'Store'">$(DefineConstants);FOOTNOTE_STORE_CHANNEL</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FootNote.Core\FootNote.Core.csproj" />
  </ItemGroup>

  <!-- Only referenced for a Pro build, and only present at all in a local
       working copy — FootNote.Pro is never committed to the public repo. -->
  <ItemGroup Condition="'$(FootNoteTier)' == 'Pro'">
    <ProjectReference Include="..\FootNote.Pro\FootNote.Pro.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WpfAnimatedGif" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- embedded, never fetched over the network -->
    <Resource Include="Assets\footnote_demo.gif" />
    <EmbeddedResource Include="Assets\PatchNotes.json" />
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

</Project>
